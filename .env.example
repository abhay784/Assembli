# --- Local upload test (Test 2 in 01-HUMAN-UAT.md) ---
# 1. Copy this file to `.env` and fill in values below.
# 2. Start Redis: `docker compose up -d redis`
# 3. Configure real S3 (or MinIO + AWS_S3_ENDPOINT) — presign fails without bucket + credentials.
# If you see "We could not start the upload" in the UI, check the server terminal and the
# `Details: …` line in dev (maps to "Could not enqueue job" = Redis, "Could not prepare upload" = S3).

# Redis (BullMQ) — required for `npm run dev:worker` and POST /api/jobs (job enqueue)
REDIS_URL=redis://127.0.0.1:6379

# AWS S3 — presigned PUT for browser upload (all required for a successful POST /api/jobs)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional: S3-compatible endpoint (e.g. MinIO)
# AWS_S3_ENDPOINT=http://127.0.0.1:9000

# Claude / Anthropic (Phase 2+) — see .env.example updates in LLM extraction plans

# Reject before Claude when PDF page count exceeds this integer (worker)
CLAUDE_MAX_PDF_PAGES=100

# Anthropic Messages API (Phase 2 extraction)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-20250514

# ElevenLabs (Phase 3 narration) — worker only; required unless placeholder mode below
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# When true (1/true/yes): skip ElevenLabs entirely; each step uses remotion/public/silence-1s.mp3
# (no credits). Use for pipeline / render testing only.
ASSEMBLI_PLACEHOLDER_AUDIO=false
